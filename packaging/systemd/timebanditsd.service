[Unit]
Description=Time Bandits screen-time daemon
Documentation=https://github.com/steviee/time-bandits
# logind is the daemon's view of who is logged in and its only way to act on a
# session, so starting before it is pointless.
After=dbus.service systemd-logind.service
Wants=dbus.service

[Service]
Type=exec
ExecStart=/usr/bin/timebanditsd
# Restarting matters more here than for most services: while the daemon is
# down, pam_timebandits fails closed for managed users, so a crash that is not
# recovered locks children out.
Restart=always
RestartSec=2

# systemd creates and owns these, which keeps the paths out of tmpfiles.d.
StateDirectory=timebandits
StateDirectoryMode=0700
RuntimeDirectory=timebandits
RuntimeDirectoryMode=0755
# ProtectSystem=strict below makes everything read-only, so this is also what
# keeps /etc/timebandits/policy.d writable — the daemon has to be able to store
# a policy the household server sends it.
ConfigurationDirectory=timebandits

# The daemon runs as root because it serves a socket in /run, controls logind,
# and reads other users' processes. It needs no capabilities beyond that: every
# privileged operation goes through D-Bus, where polkit authorises it by uid.
CapabilityBoundingSet=
AmbientCapabilities=
NoNewPrivileges=yes

ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
PrivateTmp=yes
PrivateDevices=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
UMask=0077

[Install]
WantedBy=multi-user.target
